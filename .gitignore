# Godot generated cache and imported binaries
.godot/
.import/
*.translation

# Keep resource UID sidecars (*.uid) and asset import settings (*.import)
# in version control; these are stable resource metadata, not caches.

# Local editor and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Game exports
/builds/

# Optional local native extension builds
/native/godot-cpp/
/native/bin/
/native/*.gdextension
/native/*.gdextension.uid
/native/.sconsign*
/native/src/*.o
/native/src/*.os
/native/src/*.obj

# Krita and other editor backup files
*~
