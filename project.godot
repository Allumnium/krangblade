; Warbound / Godot 4.7.2
config_version=5

[application]
config/name="Warbound"
config/version="0.89.36"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A multiplayer territory-control RTS prototype."

[autoload]
GameSession="*res://scripts/game_session.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="disabled"
window/stretch/scale=1.0
window/dpi/allow_hidpi=true

[gui]
common/snap_controls_to_pixels=true
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
